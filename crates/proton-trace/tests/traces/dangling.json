 "source": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct Node { int val; struct Node *next; } Node;\n\nint main(void) {\n    Node *a = malloc(sizeof(Node));\n    a->val = 1;\n    a->next = malloc(sizeof(Node));\n    a->next->val = 2;\n    a->next->next = NULL;\n\n    free(a->next);              /* a->next is now dangling */\n    printf(\"%d\\n\", a->next->val);  /* read of freed memory */\n\n    free(a);\n    return 0;\n}\n",
