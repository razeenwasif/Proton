{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Proton",
  "version": "0.0.1",
  "identifier": "dev.razeen.proton",
  "build": {
    "frontendDist": "../../ui",
    "beforeBuildCommand": "cargo build --release -p proton-mcp"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Proton",
        "width": 1600,
        "height": 1000,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost artifact: http://artifact.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self' study: http://study.localhost; script-src 'self'; frame-src 'self' artifact: http://artifact.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../vendor/code-visualizer/server": "code-visualizer/server",
      "../../vendor/code-visualizer/backends": "code-visualizer/backends",
      "../../vendor/code-visualizer/examples": "code-visualizer/examples"
    }
  }
}
